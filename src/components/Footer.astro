---
import "../styles/global.css";

import Newsletter from "./Newsletter.astro";
---

<footer class="bg-sky-100">
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-6 sm:px-6 lg:px-8">
        <div class="lg:flex lg:items-start lg:gap-12">
            <div class="pb-4">
                <p class="text-2xl font-medium pb-2">
                    Join our mailing list!
                </p>
                <p class="text-gray-700">
                    Get exclusive deals and intresting development insights.
                </p>
            </div>

            <div class="w-max lg:grow">
                <Newsletter class="" />
                <p class="text-gray-500 pt-2 font-medium text-xs">
                    (Very infrequent emails)
                </p>
            </div>
        </div>

        <div class="mt-8 border-t border-gray-100 pt-8">
            <div class="sm:flex sm:justify-between">
                <p class="text-xs text-gray-500">
                    Copyright 2026 © Icy Electronics.
                </p>
                <p class="text-xs text-gray-500">
                    <a href="/privacy-policy">
                        Privacy Policy
                    </a>
                </p>
            </div>
        </div>
    </div>
</footer>
