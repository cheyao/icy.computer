---
import "../styles/global.css";

import Newsletter from "./Newsletter.astro";
---

<footer class="bg-sky-100">
    <div class="mx-auto max-w-7xl px-4 pt-16 pb-6 sm:px-6 lg:px-8">
        <div class="lg:flex lg:items-start lg:gap-8">
            <div
                class="mt-8 gap-8 grid grid-cols-2 sm:grid-cols-3 sm:mt-4 lg:mt-0 lg:grid-cols-6 lg:gap-y-16"
            >
                <div class="col-span-2 sm:col-span-1">
                    <p class="font-medium text-gray-900">Company</p>

                    <ul class="mt-6 space-y-4 text-sm">
                        <li>
                            <a
                                href="/"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                Home
                            </a>
                        </li>
                        <li>
                            <a
                                href="/about-us"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                About
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-span-2 sm:col-span-1">
                    <p class="font-medium text-gray-900">Information</p>

                    <ul class="mt-6 space-y-4 text-sm">
                        <li>
                            <a
                                href="/privacy-policy"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                Privacy Policy
                            </a>
                        </li>

                        <li>
                            <a
                                href="#"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                Returns & Refund Policy
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-span-2 sm:col-span-1">
                    <p class="font-medium text-gray-900">Helpful Links</p>

                    <ul class="mt-6 space-y-4 text-sm">
                        <li>
                            <a
                                href="mailto:info@icy.computer"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                Contact
                            </a>
                        </li>

                        <li>
                            <a
                                href="#"
                                class="text-gray-700 transition hover:opacity-75"
                            >
                                FAQs
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-span-3 sm:col-span-2">
                    <p class="font-medium text-gray-900 pb-6">Subscribe to our newsletter!</p>
                    <Newsletter />
                    <p class="text-gray-500 pt-2 font-medium text-xs">(&lt;1 email per quater)</p>
                </div>
            </div>
        </div>

        <div class="mt-8 border-t border-gray-100 pt-8">
            <div class="sm:flex sm:justify-between">
                <p class="text-xs text-gray-500">
                    Copyright 2026 © Icy Electronics.
                </p>
                <p class="text-xs text-gray-500">
                </p>
            </div>
        </div>
    </div>
</footer>
