---
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import ProductGrid from "../components/ProductGrid.astro";
import comuFinger from "../assets/products/comu-finger.jpg";

const comuUrl = "https://www.crowdsupply.com/icy-electronics/comu";
---

<Layout>
    <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
        <div class="grid items-center overflow-hidden rounded-lg bg-sky-100 md:grid-cols-2">
            <div class="px-6 py-10 sm:px-10 md:py-14">
                <h2 class="mt-5 text-4xl font-bold text-gray-900 sm:text-5xl">Comu</h2>
                <p class="mt-3 max-w-md text-lg text-gray-700">
                    A bare-metal RISC-V board that fits inside your USB connector.
                    Sign up on Crowd Supply to hear the moment it launches.
                </p>
                <a
                    href={comuUrl}
                    target="_blank"
                    rel="noopener"
                    class="mt-8 inline-flex items-center gap-2 rounded-md bg-teal-600 px-5 py-3 font-medium text-white shadow-sm transition-colors hover:bg-teal-700"
                >
                    Get notified on Crowd Supply
                    <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <!-- Flush with the card's right and bottom edges, where the finger leaves the frame -->
            <a href={comuUrl} target="_blank" rel="noopener" class="block self-end">
                <Image
                    src={comuFinger}
                    alt="Comu RISC-V board balanced on a fingertip"
                    width={1000}
                    class="block w-full mix-blend-multiply"
                />
            </a>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <ProductGrid />
    </section>
</Layout>
